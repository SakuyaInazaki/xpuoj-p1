+
+
+_FP6_ROUNDTRIP_KEYS = (
+    (4096, 4096, 256, 2048, 8),
+    (4096, 4096, 256, 1536, 8),
+)
+_FP6_ROUNDTRIP_CACHE = {}
+
+
+@triton.jit
+def _fp6_roundtrip_kernel(Q, BLOCK: tl.constexpr):
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    raw = tl.load(Q + offs).to(tl.int32)
+    mag = raw & 0x7f
+    low = tl.where(mag <= 72, 0,
+          tl.where(mag < 84, 80,
+          tl.where(mag <= 90, 88,
+          tl.where(mag < 94, 92,
+          tl.where(mag <= 97, 96,
+          tl.where(mag < 99, 98,
+          tl.where(mag <= 101, 100,
+          tl.where(mag < 103, 102, 104))))))))
+    out = (raw & 0x80) | tl.where(mag >= 104, mag, low)
+    tl.store(Q + offs, out)
+
+
+def _fp6_roundtrip_(q):
+    n = q.numel()
+    block = 8192
+    assert n % block == 0
+    _fp6_roundtrip_kernel[(triton.cdiv(n, block),)](
+        q.view(torch.uint8), BLOCK=block, num_warps=8)
+
+
+def _get_fp6_roundtrip_weights(gate, up, down, lowmem):
+    key = (lowmem,) + tuple((id(w), w.data_ptr(), tuple(w.shape)) for w in (gate, up, down))
+    entry = _FP6_ROUNDTRIP_CACHE.get(key)
+    if entry is not None:
+        return entry[1]
+    base_cache = _FULL_FP8_LOWMEM_CACHE if lowmem else _FULL_FP8_CACHE
+    base_cache.clear()
+    if not lowmem:
+        _FULL_WEIGHT_CACHE.clear()
+    cached = (_get_full_fp8_weights_lowmem if lowmem else _get_full_fp8_weights)(gate, up, down)
+    base_cache.clear()  # Do not expose probe weights through the shape-only base cache.
+    if not lowmem:
+        _FULL_WEIGHT_CACHE.clear()
+    _fp6_roundtrip_(cached[0])
+    _fp6_roundtrip_(cached[2])
+    _FP6_ROUNDTRIP_CACHE.clear()
+    _FP6_ROUNDTRIP_CACHE[key] = ((gate, up, down), cached)
+    return cached
